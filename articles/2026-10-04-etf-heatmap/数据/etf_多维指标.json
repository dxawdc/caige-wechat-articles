  "metrics": [
    {
      "key": "m5",
      "label": "5日动量",
      "unit": "%",
      "kind": "signed",
      "scale": "momentum",
      "formula": "(C_t/C_(t-5)-1)×100"
    },
    {
      "key": "m10",
      "label": "10日动量",
      "unit": "%",
      "kind": "signed",
      "scale": "momentum",
      "formula": "(C_t/C_(t-10)-1)×100"
    },
    {
      "key": "m20",
      "label": "20日动量",
      "unit": "%",
      "kind": "signed",
      "scale": "momentum",
      "formula": "(C_t/C_(t-20)-1)×100；20个收益观测需要21个收盘价"
    },
    {
      "key": "accel5",
      "label": "5日加速度",
      "unit": "百分点",
      "kind": "signed",
      "scale": "accel5",
      "formula": "本5日动量−前5日动量；前5日=(C_(t-5)/C_(t-10)-1)×100"
    },
    {
      "key": "excess20",
      "label": "20日超额",
      "unit": "百分点",
      "kind": "signed",
      "scale": "excess20",
      "formula": "ETF20日动量−沪深300ETF(510300)20日动量；为收益率之差"
    },
    {
      "key": "bias20",
      "label": "MA20乖离",
      "unit": "%",
      "kind": "signed",
      "scale": "bias20",
      "formula": "(最新收盘价/最近20日收盘价均值-1)×100"
    },
    {
      "key": "rsi14",
      "label": "RSI(14)",
      "unit": "0–100",
      "kind": "strength",
      "scale": "hundred",
      "formula": "Wilder RSI：前14个价差涨/跌额均值初始化，其后(前值×13+当日值)/14；使用全部120日历史"
    },
    {
      "key": "up20",
      "label": "上涨占比",
      "unit": "%",
      "kind": "strength",
      "scale": "hundred",
      "formula": "近20日收盘价严格上涨的天数/20×100；平盘算入分母"
    },
    {
      "key": "vol20",
      "label": "年化波动",
      "unit": "%",
      "kind": "risk",
      "scale": "vol20",
      "formula": "近20日简单收益率样本标准差(ddof=1)×√252×100"
    },
    {
      "key": "mdd20",
      "label": "最大回撤",
      "unit": "%",
      "kind": "risk",
      "scale": "mdd20",
      "formula": "max(1-当日收盘价/窗口截至当日最高收盘价)×100；含前一日基准收盘价，共21个价位；显示正幅度"
    },
    {
      "key": "volume_ratio",
      "label": "5/20均量",
      "unit": "倍",
      "kind": "strength",
      "scale": "volume_ratio",
      "formula": "近5日平均成交量/近20日平均成交量；大于1表示近期均量高于20日均量"
    }
  ],
